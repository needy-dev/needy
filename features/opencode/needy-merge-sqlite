#!/usr/bin/env python3
"""Three-way SQLite row-merge driver for needy sync mappings (opencode feature).

Three-tree driver contract:
  needy-merge-sqlite <seed_dir> <run_dir> <store_dir> <out_dir>

  - <seed_dir>:  claimed files as they were when the run was seeded
  - <run_dir>:   claimed files from the run's per-run copy
  - <store_dir>: claimed files currently in the store
  - <out_dir>:   empty writable directory where merged files are written

Behavior:
  - Copies each database together with any SQLite side files (-wal, -shm,
    -journal) into a temporary directory and checkpoints WAL frames cleanly
    before reading.
  - Merges each user table three-way per row by its explicit primary key:
    * insertions from either side are kept;
    * updates/deletions made only by the run are applied;
    * identical changes on both sides are kept without conflict;
    * conflicting changes to the same primary key are reported on stderr and
      cause a non-zero exit (leaving the store unchanged).
  - Refuses tables keyed by AUTOINCREMENT integer primary keys (per
    docs/ai/references/architecture/2026-11-17-images-and-run-data-spec.md)
    rather than colliding or renumbering IDs.
  - Verifies `PRAGMA integrity_check` on every merged database and writes a
    clean, checkpointed database file (no -wal/-shm side files) into <out_dir>.
"""

from __future__ import annotations

import os
import re
import shutil
import sqlite3
import sys
import tempfile
from pathlib import Path

SQLITE_MAGIC = b"SQLite format 3\x00"
SIDE_SUFFIXES = ("-wal", "-shm", "-journal")
AUTOINCREMENT_RE = re.compile(r"\bAUTOINCREMENT\b", re.IGNORECASE)


def qident(name: str) -> str:
  return '"' + name.replace('"', '""') + '"'


def is_side_file(rel: str) -> bool:
  return any(rel.endswith(suffix) for suffix in SIDE_SUFFIXES)


def is_sqlite_file(path: Path) -> bool:
  if not path.is_file():
    return False
  try:
    with path.open("rb") as f:
      header = f.read(len(SQLITE_MAGIC))
  except OSError:
    return False
  return header == SQLITE_MAGIC or path.stat().st_size == 0


def collect_db_paths(*roots: Path) -> list[str]:
  rels: set[str] = set()
  for root in roots:
    if not root.is_dir():
      continue
    for dirpath, _dirnames, filenames in os.walk(root):
      for fname in filenames:
        full = Path(dirpath) / fname
        rel = full.relative_to(root).as_posix()
        if is_side_file(rel):
          continue
        rels.add(rel)
  return sorted(rels)


def stage_and_checkpoint(src_root: Path, rel: str, tmp_dir: Path, label: str) -> Path | None:
  """Copies `src_root/rel` and any SQLite side files into `tmp_dir/label/`
  and folds any WAL frames into the main database file."""
  src = src_root / rel
  if not src.is_file():
    return None
  if not is_sqlite_file(src):
    raise RuntimeError(f"{label}/{rel} is not a SQLite database")

  work_dir = tmp_dir / label
  dst = work_dir / rel
  dst.parent.mkdir(parents=True, exist_ok=True)
  shutil.copy2(src, dst)
  for suffix in SIDE_SUFFIXES:
    side_src = Path(f"{src}{suffix}")
    if side_src.is_file():
      shutil.copy2(side_src, Path(f"{dst}{suffix}"))

  conn = sqlite3.connect(str(dst))
  try:
    conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    conn.execute("PRAGMA journal_mode=DELETE")
    conn.commit()
  finally:
    conn.close()

  for suffix in SIDE_SUFFIXES:
    side_dst = Path(f"{dst}{suffix}")
    if side_dst.exists():
      side_dst.unlink()
  return dst


def list_user_tables(conn: sqlite3.Connection) -> dict[str, str]:
  rows = conn.execute(
    "SELECT name, sql FROM sqlite_master "
    "WHERE type = 'table' AND name NOT LIKE 'sqlite_%' AND sql IS NOT NULL"
  ).fetchall()
  return {name: sql for name, sql in rows}


def sqlite_sequence_tables(conn: sqlite3.Connection) -> set[str]:
  row = conn.execute(
    "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'sqlite_sequence'"
  ).fetchone()
  if row is None:
    return set()
  return {r[0] for r in conn.execute("SELECT name FROM sqlite_sequence").fetchall()}


def table_schema(conn: sqlite3.Connection, table: str) -> tuple[list[str], list[str]]:
  """Returns (all_columns, pk_columns_in_order) for `table`."""
  info = conn.execute(f"PRAGMA table_info({qident(table)})").fetchall()
  cols = [row[1] for row in info]
  pks = [row[1] for row in sorted((r for r in info if r[5] > 0), key=lambda r: r[5])]
  return cols, pks


def read_rows_by_pk(
  conn: sqlite3.Connection, table: str, cols: list[str], pk_cols: list[str]
) -> dict[tuple, tuple]:
  col_list = ", ".join(qident(c) for c in cols)
  pk_indices = [cols.index(c) for c in pk_cols]
  rows: dict[tuple, tuple] = {}
  for row in conn.execute(f"SELECT {col_list} FROM {qident(table)}"):
    key = tuple(row[i] for i in pk_indices)
    rows[key] = row
  return rows


def merge_one_db(
  rel: str,
  seed_db: Path | None,
  run_db: Path | None,
  store_db: Path | None,
  out_path: Path,
  tmp_dir: Path,
) -> list[str]:
  """Merges one SQLite database. Returns a list of error/conflict messages
  (empty on clean merge)."""
  out_path.parent.mkdir(parents=True, exist_ok=True)

  # Only the run has this database: take it directly.
  if store_db is None:
    if run_db is not None:
      shutil.copy2(run_db, out_path)
    return []

  # The run deleted (or never had) the database.
  if run_db is None:
    if seed_db is not None and seed_db.read_bytes() == store_db.read_bytes():
      # Only the run removed it; omit from out_dir.
      return []
    # Store changed (or created) it while run does not have it; keep store's.
    shutil.copy2(store_db, out_path)
    return []

  # Fast path: run did not change the database relative to seed or store.
  run_bytes = run_db.read_bytes()
  if (seed_db is not None and run_bytes == seed_db.read_bytes()) or run_bytes == store_db.read_bytes():
    shutil.copy2(store_db, out_path)
    return []

  # Fast path: store did not change since seed; take run's checkpointed copy.
  if seed_db is not None and store_db.read_bytes() == seed_db.read_bytes():
    shutil.copy2(run_db, out_path)
    return []

  # Both run and store diverged (or both created from no seed): three-way row merge.
  merged_tmp = tmp_dir / "merged" / rel
  merged_tmp.parent.mkdir(parents=True, exist_ok=True)
  shutil.copy2(store_db, merged_tmp)

  seed_conn = sqlite3.connect(f"file:{seed_db}?mode=ro", uri=True) if seed_db is not None else None
  run_conn = sqlite3.connect(f"file:{run_db}?mode=ro", uri=True)
  out_conn = sqlite3.connect(str(merged_tmp))

  errors: list[str] = []
  try:
    out_conn.execute("PRAGMA foreign_keys = OFF")

    seed_tables = list_user_tables(seed_conn) if seed_conn is not None else {}
    run_tables = list_user_tables(run_conn)
    store_tables = list_user_tables(out_conn)

    seq_tables = sqlite_sequence_tables(out_conn) | sqlite_sequence_tables(run_conn)
    all_tables = sorted(set(store_tables) | set(run_tables))

    # Reject AUTOINCREMENT tables before mutating anything.
    for table in all_tables:
      sqls = [s for s in (store_tables.get(table), run_tables.get(table)) if s is not None]
      if table in seq_tables or any(AUTOINCREMENT_RE.search(sql) for sql in sqls):
        errors.append(
          f"{rel}: table {table!r} uses AUTOINCREMENT primary key and cannot be row-merged"
        )
    if errors:
      return errors

    for table in all_tables:
      in_store = table in store_tables
      in_run = table in run_tables
      if not in_run:
        continue

      run_cols, run_pks = table_schema(run_conn, table)
      if not in_store:
        # Table added only by run: create it and copy its rows.
        out_conn.execute(run_tables[table])
        col_list = ", ".join(qident(c) for c in run_cols)
        placeholders = ", ".join("?" for _ in run_cols)
        rows = run_conn.execute(f"SELECT {col_list} FROM {qident(table)}").fetchall()
        if rows:
          out_conn.executemany(
            f"INSERT INTO {qident(table)} ({col_list}) VALUES ({placeholders})",
            rows,
          )
        continue

      store_cols, store_pks = table_schema(out_conn, table)
      if store_cols != run_cols or store_pks != run_pks:
        errors.append(
          f"{rel}: table {table!r} schema differs between run and store and cannot be row-merged"
        )
        continue

      if not store_pks:
        # Table without an explicit primary key cannot be merged row-by-row.
        col_list = ", ".join(qident(c) for c in store_cols)
        run_all = run_conn.execute(f"SELECT {col_list} FROM {qident(table)}").fetchall()
        store_all = out_conn.execute(f"SELECT {col_list} FROM {qident(table)}").fetchall()
        seed_all = (
          seed_conn.execute(f"SELECT {col_list} FROM {qident(table)}").fetchall()
          if seed_conn is not None and table in seed_tables
          else []
        )
        if run_all != seed_all and run_all != store_all:
          errors.append(
            f"{rel}: table {table!r} has no explicit primary key and cannot be row-merged"
          )
        continue

      seed_rows: dict[tuple, tuple] = {}
      if seed_conn is not None and table in seed_tables:
        seed_cols, seed_pks = table_schema(seed_conn, table)
        if seed_cols == store_cols and seed_pks == store_pks:
          seed_rows = read_rows_by_pk(seed_conn, table, store_cols, store_pks)

      run_rows = read_rows_by_pk(run_conn, table, run_cols, run_pks)
      store_rows = read_rows_by_pk(out_conn, table, store_cols, store_pks)

      col_list = ", ".join(qident(c) for c in store_cols)
      placeholders = ", ".join("?" for _ in store_cols)
      pk_where = " AND ".join(f"{qident(c)} = ?" for c in store_pks)

      for pk in set(seed_rows) | set(run_rows) | set(store_rows):
        s = seed_rows.get(pk)
        r = run_rows.get(pk)
        t = store_rows.get(pk)
        if r == s or r == t:
          continue
        if t == s:
          if r is None:
            out_conn.execute(f"DELETE FROM {qident(table)} WHERE {pk_where}", pk)
          else:
            out_conn.execute(
              f"INSERT OR REPLACE INTO {qident(table)} ({col_list}) VALUES ({placeholders})",
              r,
            )
        else:
          errors.append(f"{rel}: conflict in table {table!r} for primary key {pk!r}")

    if errors:
      out_conn.rollback()
      return errors

    out_conn.commit()
    check = out_conn.execute("PRAGMA integrity_check").fetchall()
    if check != [("ok",)]:
      return [f"{rel}: integrity_check failed after merge: {check!r}"]

    out_conn.execute("PRAGMA journal_mode=DELETE")
    out_conn.commit()
  finally:
    if seed_conn is not None:
      seed_conn.close()
    run_conn.close()
    out_conn.close()

  shutil.copy2(merged_tmp, out_path)
  return []


def main(argv: list[str]) -> int:
  if len(argv) != 5:
    print(
      f"usage: {argv[0]} <seed_dir> <run_dir> <store_dir> <out_dir>",
      file=sys.stderr,
    )
    return 2

  seed_dir, run_dir, store_dir, out_dir = (Path(p) for p in argv[1:5])
  out_dir.mkdir(parents=True, exist_ok=True)

  db_rels = collect_db_paths(seed_dir, run_dir, store_dir)
  all_errors: list[str] = []

  with tempfile.TemporaryDirectory(prefix="needy-merge-sqlite-") as tmp:
    tmp_dir = Path(tmp)
    for rel in db_rels:
      try:
        seed_db = stage_and_checkpoint(seed_dir, rel, tmp_dir, "seed")
        run_db = stage_and_checkpoint(run_dir, rel, tmp_dir, "run")
        store_db = stage_and_checkpoint(store_dir, rel, tmp_dir, "store")
        errs = merge_one_db(rel, seed_db, run_db, store_db, out_dir / rel, tmp_dir)
        all_errors.extend(errs)
      except Exception as exc:  # noqa: BLE001
        all_errors.append(f"{rel}: {exc}")

  if all_errors:
    for err in all_errors:
      print(f"needy-merge-sqlite: {err}", file=sys.stderr)
    return 1
  return 0


if __name__ == "__main__":
  sys.exit(main(sys.argv))
