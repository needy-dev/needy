#!/bin/sh
# Three-way SQLite row-merge driver for needy sync mappings (opencode feature).
#
# Three-tree driver contract:
#   needy-merge-sqlite <base_dir> <run_dir> <current_dir> <merged_dir>
#
#   - <base_dir>:    claimed files as they were when the run started (common ancestor)
#   - <run_dir>:     claimed files from the run's per-run copy
#   - <current_dir>: claimed files currently in the persistent store
#   - <merged_dir>:  empty writable directory where merged files are written
#
# Uses the `sqlite3` CLI with `ATTACH DATABASE` so all row data (TEXT, BLOB,
# NULL, quotes, newlines, composite primary keys) stays inside SQLite's own SQL
# engine without passing values through shell variables.
set -eu

if [ "$#" -ne 4 ]; then
  printf 'usage: %s <base_dir> <run_dir> <current_dir> <merged_dir>\n' "$0" >&2
  exit 2
fi

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'needy-merge-sqlite: sqlite3 CLI is required but not found on PATH\n' >&2
  exit 1
fi

BASE_DIR=$1
RUN_DIR=$2
CURRENT_DIR=$3
MERGED_DIR=$4

mkdir -p "$MERGED_DIR"

TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/needy-merge-sqlite-XXXXXX")
trap 'rm -rf "$TMP_DIR"' EXIT INT TERM

# Escapes a SQLite identifier by doubling `"`.
qident() {
  printf '%s' "$1" | sed 's/"/""/g'
}

# Escapes a SQLite single-quoted string literal by doubling `'`.
qlit() {
  printf '%s' "$1" | sed "s/'/''/g"
}

is_sqlite_file() {
  file=$1
  [ -f "$file" ] || return 1
  if [ ! -s "$file" ]; then
    return 0
  fi
  magic=$(head -c 15 "$file" 2>/dev/null || true)
  [ "$magic" = "SQLite format 3" ]
}

# Copies `src_root/rel` and any SQLite side files (-wal, -shm, -journal) into
# `TMP_DIR/label/rel`, checkpoints WAL frames into the main DB, and removes
# side files. Echoes the staged path, or nothing if absent.
stage_and_checkpoint() {
  src_root=$1
  rel=$2
  label=$3
  src="$src_root/$rel"
  if [ ! -f "$src" ]; then
    return 0
  fi
  if ! is_sqlite_file "$src"; then
    printf 'needy-merge-sqlite: %s/%s is not a SQLite database\n' "$label" "$rel" >&2
    return 1
  fi
  dst="$TMP_DIR/$label/$rel"
  mkdir -p "$(dirname "$dst")"
  cp -p "$src" "$dst"
  for suffix in -wal -shm -journal; do
    if [ -f "${src}${suffix}" ]; then
      cp -p "${src}${suffix}" "${dst}${suffix}"
    fi
  done
  sqlite3 "$dst" "PRAGMA wal_checkpoint(TRUNCATE); PRAGMA journal_mode=DELETE;" >/dev/null
  rm -f "${dst}-wal" "${dst}-shm" "${dst}-journal"
  printf '%s\n' "$dst"
}

# Collects unique relative paths of non-side files across all three trees.
collect_db_paths() {
  for root in "$BASE_DIR" "$RUN_DIR" "$CURRENT_DIR"; do
    [ -d "$root" ] || continue
    (
      cd "$root"
      find . -type f | sed 's|^\./||'
    )
  done | awk '
    /-wal$/ || /-shm$/ || /-journal$/ { next }
    { print }
  ' | LC_ALL=C sort -u
}

# Extracts table schema metadata: prints `col|pk_pos` lines in column order.
table_info_lines() {
  db=$1
  tbl=$2
  qtbl=$(qident "$tbl")
  sqlite3 -separator '|' "$db" "PRAGMA table_info(\"$qtbl\");" | awk -F'|' '{ print $2 "|" $6 }'
}

# Checks whether `db` has a table named `tbl`.
db_has_table() {
  db=$1
  tbl=$2
  ltbl=$(qlit "$tbl")
  found=$(sqlite3 "$db" "SELECT 1 FROM sqlite_master WHERE type='table' AND name='$ltbl' AND sql IS NOT NULL LIMIT 1;")
  [ "$found" = "1" ]
}

# Builds SQL expressions and merges one table from `run_db` into `main`
# (with optional `seed_db`). Writes conflict lines to stderr and returns 1
# on any schema/PK/row conflict.
merge_one_table() {
  rel=$1
  merged_db=$2
  run_db=$3
  seed_db=$4
  tbl=$5
  sql_file=$6

  qtbl=$(qident "$tbl")
  ltbl=$(qlit "$tbl")
  qrun=$(qlit "$run_db")

  if ! db_has_table "$run_db" "$tbl"; then
    return 0
  fi

  if ! db_has_table "$merged_db" "$tbl"; then
    create_sql=$(sqlite3 "$run_db" "SELECT sql FROM sqlite_master WHERE type='table' AND name='$ltbl';")
    {
      printf '%s;\n' "$create_sql"
      printf 'INSERT INTO main."%s" SELECT * FROM run_db."%s";\n' "$qtbl" "$qtbl"
    } >>"$sql_file"
    return 0
  fi

  store_schema=$(table_info_lines "$merged_db" "$tbl")
  run_schema=$(table_info_lines "$run_db" "$tbl")
  if [ "$store_schema" != "$run_schema" ]; then
    printf "needy-merge-sqlite: %s: table '%s' schema differs between run and store and cannot be row-merged\n" "$rel" "$tbl" >&2
    return 1
  fi

  has_seed=0
  if [ -n "$seed_db" ] && db_has_table "$seed_db" "$tbl"; then
    seed_schema=$(table_info_lines "$seed_db" "$tbl")
    if [ "$seed_schema" = "$store_schema" ]; then
      has_seed=1
    fi
  fi

  # Extract all columns (in order) and PK columns (sorted by pk position).
  cols_file="$TMP_DIR/cols.txt"
  pks_file="$TMP_DIR/pks.txt"
  printf '%s\n' "$store_schema" | awk -F'|' 'NF >= 2 { print $1 }' >"$cols_file"
  printf '%s\n' "$store_schema" | awk -F'|' 'NF >= 2 && $2 + 0 > 0 { print $2 "|" $1 }' | sort -t'|' -k1,1n | awk -F'|' '{ print $2 }' >"$pks_file"

  if [ ! -s "$pks_file" ]; then
    # Table has no explicit primary key: allow only if run == store or run == seed.
    attach_sql="ATTACH DATABASE '$qrun' AS run_db;"
    if [ "$has_seed" -eq 1 ]; then
      qseed=$(qlit "$seed_db")
      attach_sql="$attach_sql ATTACH DATABASE '$qseed' AS seed_db;"
    fi
    diff_store=$(sqlite3 "$merged_db" "$attach_sql SELECT count(*) FROM (SELECT * FROM run_db.\"$qtbl\" EXCEPT SELECT * FROM main.\"$qtbl\" UNION ALL SELECT * FROM main.\"$qtbl\" EXCEPT SELECT * FROM run_db.\"$qtbl\");")
    if [ "$diff_store" != "0" ]; then
      if [ "$has_seed" -eq 1 ]; then
        diff_seed=$(sqlite3 "$merged_db" "$attach_sql SELECT count(*) FROM (SELECT * FROM run_db.\"$qtbl\" EXCEPT SELECT * FROM seed_db.\"$qtbl\" UNION ALL SELECT * FROM seed_db.\"$qtbl\" EXCEPT SELECT * FROM run_db.\"$qtbl\");")
      else
        diff_seed="1"
      fi
      if [ "$diff_seed" != "0" ]; then
        printf "needy-merge-sqlite: %s: table '%s' has no explicit primary key and cannot be row-merged\n" "$rel" "$tbl" >&2
        return 1
      fi
    fi
    return 0
  fi

  # Build SQL column lists and join/equality predicates.
  col_list=""
  r_col_list=""
  row_eq_rt=""
  row_eq_rs=""
  row_eq_ts=""
  row_eq_ms=""
  while IFS= read -r col; do
    [ -n "$col" ] || continue
    qcol=$(qident "$col")
    col_list="${col_list:+${col_list}, }\"$qcol\""
    r_col_list="${r_col_list:+${r_col_list}, }r.\"$qcol\""
    row_eq_rt="${row_eq_rt:+${row_eq_rt} AND }r.\"$qcol\" IS t.\"$qcol\""
    row_eq_rs="${row_eq_rs:+${row_eq_rs} AND }r.\"$qcol\" IS s.\"$qcol\""
    row_eq_ts="${row_eq_ts:+${row_eq_ts} AND }t.\"$qcol\" IS s.\"$qcol\""
    row_eq_ms="${row_eq_ms:+${row_eq_ms} AND }main.\"$qtbl\".\"$qcol\" IS s.\"$qcol\""
  done <"$cols_file"

  first_pk=""
  pk_eq_rt=""
  pk_eq_rs=""
  pk_eq_sr=""
  pk_eq_st=""
  pk_eq_tr=""
  pk_eq_ms=""
  pk_disp_r=""
  pk_disp_s=""
  while IFS= read -r pk; do
    [ -n "$pk" ] || continue
    qpk=$(qident "$pk")
    if [ -z "$first_pk" ]; then
      first_pk=$qpk
    fi
    pk_eq_rt="${pk_eq_rt:+${pk_eq_rt} AND }r.\"$qpk\" IS t.\"$qpk\""
    pk_eq_rs="${pk_eq_rs:+${pk_eq_rs} AND }r.\"$qpk\" IS s.\"$qpk\""
    pk_eq_sr="${pk_eq_sr:+${pk_eq_sr} AND }s.\"$qpk\" IS r.\"$qpk\""
    pk_eq_st="${pk_eq_st:+${pk_eq_st} AND }s.\"$qpk\" IS t.\"$qpk\""
    pk_eq_tr="${pk_eq_tr:+${pk_eq_tr} AND }t.\"$qpk\" IS r.\"$qpk\""
    pk_eq_ms="${pk_eq_ms:+${pk_eq_ms} AND }main.\"$qtbl\".\"$qpk\" IS s.\"$qpk\""
    pk_disp_r="${pk_disp_r:+${pk_disp_r} || ',' || }COALESCE(CAST(r.\"$qpk\" AS TEXT), 'NULL')"
    pk_disp_s="${pk_disp_s:+${pk_disp_s} || ',' || }COALESCE(CAST(s.\"$qpk\" AS TEXT), 'NULL')"
  done <"$pks_file"

  # 1. Detect row-level conflicts before emitting mutations.
  attach_sql="ATTACH DATABASE '$qrun' AS run_db;"
  if [ "$has_seed" -eq 1 ]; then
    qseed=$(qlit "$seed_db")
    attach_sql="$attach_sql ATTACH DATABASE '$qseed' AS seed_db;"
    conflict_sql="
      SELECT $pk_disp_r FROM run_db.\"$qtbl\" r
      JOIN main.\"$qtbl\" t ON $pk_eq_rt
      LEFT JOIN seed_db.\"$qtbl\" s ON $pk_eq_rs
      WHERE NOT ($row_eq_rt)
        AND (s.\"$first_pk\" IS NULL OR (NOT ($row_eq_rs) AND NOT ($row_eq_ts)))
      UNION
      SELECT $pk_disp_s FROM seed_db.\"$qtbl\" s
      JOIN main.\"$qtbl\" t ON $pk_eq_st
      LEFT JOIN run_db.\"$qtbl\" r ON $pk_eq_sr
      WHERE r.\"$first_pk\" IS NULL AND NOT ($row_eq_ts)
      UNION
      SELECT $pk_disp_s FROM seed_db.\"$qtbl\" s
      JOIN run_db.\"$qtbl\" r ON $pk_eq_sr
      LEFT JOIN main.\"$qtbl\" t ON $pk_eq_st
      WHERE t.\"$first_pk\" IS NULL AND NOT ($row_eq_rs);
    "
  else
    conflict_sql="
      SELECT $pk_disp_r FROM run_db.\"$qtbl\" r
      JOIN main.\"$qtbl\" t ON $pk_eq_rt
      WHERE NOT ($row_eq_rt);
    "
  fi

  conflicts=$(sqlite3 "$merged_db" "$attach_sql $conflict_sql")
  if [ -n "$conflicts" ]; then
    printf '%s\n' "$conflicts" | while IFS= read -r pk_val; do
      [ -n "$pk_val" ] || continue
      printf "needy-merge-sqlite: %s: conflict in table '%s' for primary key '%s'\n" "$rel" "$tbl" "$pk_val" >&2
    done
    return 1
  fi

  # 2. Emit clean mutations for this table.
  if [ "$has_seed" -eq 1 ]; then
    cat >>"$sql_file" <<EOF
DELETE FROM main."$qtbl"
WHERE EXISTS (
  SELECT 1 FROM seed_db."$qtbl" s
  WHERE $pk_eq_ms AND $row_eq_ms
    AND NOT EXISTS (SELECT 1 FROM run_db."$qtbl" r WHERE $pk_eq_rs)
);
INSERT INTO main."$qtbl" ($col_list)
SELECT $r_col_list FROM run_db."$qtbl" r
WHERE NOT EXISTS (SELECT 1 FROM main."$qtbl" t WHERE $pk_eq_tr)
  AND NOT EXISTS (SELECT 1 FROM seed_db."$qtbl" s WHERE $pk_eq_rs);
INSERT OR REPLACE INTO main."$qtbl" ($col_list)
SELECT $r_col_list FROM run_db."$qtbl" r
JOIN main."$qtbl" t ON $pk_eq_rt
JOIN seed_db."$qtbl" s ON $pk_eq_rs
WHERE NOT ($row_eq_rt) AND $row_eq_ts;
EOF
  else
    cat >>"$sql_file" <<EOF
INSERT INTO main."$qtbl" ($col_list)
SELECT $r_col_list FROM run_db."$qtbl" r
WHERE NOT EXISTS (SELECT 1 FROM main."$qtbl" t WHERE $pk_eq_tr);
EOF
  fi
}

merge_one_db() {
  rel=$1
  out_path="$MERGED_DIR/$rel"
  mkdir -p "$(dirname "$out_path")"

  seed_db=$(stage_and_checkpoint "$BASE_DIR" "$rel" "base")
  run_db=$(stage_and_checkpoint "$RUN_DIR" "$rel" "run")
  store_db=$(stage_and_checkpoint "$CURRENT_DIR" "$rel" "current")

  # Only the run has this database: take it directly.
  if [ -z "$store_db" ]; then
    if [ -n "$run_db" ]; then
      cp -p "$run_db" "$out_path"
    fi
    return 0
  fi

  # The run deleted (or never had) the database.
  if [ -z "$run_db" ]; then
    if [ -n "$seed_db" ] && cmp -s "$seed_db" "$store_db"; then
      return 0
    fi
    cp -p "$store_db" "$out_path"
    return 0
  fi

  # Fast path: run did not change the database relative to seed or store.
  if cmp -s "$run_db" "$store_db"; then
    cp -p "$store_db" "$out_path"
    return 0
  fi
  if [ -n "$seed_db" ] && cmp -s "$run_db" "$seed_db"; then
    cp -p "$store_db" "$out_path"
    return 0
  fi

  # Fast path: store did not change since seed; take run's checkpointed copy.
  if [ -n "$seed_db" ] && cmp -s "$store_db" "$seed_db"; then
    cp -p "$run_db" "$out_path"
    return 0
  fi

  # Both run and store diverged (or both created from no seed): three-way row merge.
  merged_tmp="$TMP_DIR/merged/$rel"
  mkdir -p "$(dirname "$merged_tmp")"
  cp -p "$store_db" "$merged_tmp"

  # Reject AUTOINCREMENT tables before mutating anything.
  autoinc_tables=$(
    for db in "$merged_tmp" "$run_db"; do
      sqlite3 "$db" "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND sql LIKE '%AUTOINCREMENT%';"
      if db_has_table "$db" "sqlite_sequence"; then
        sqlite3 "$db" "SELECT name FROM sqlite_sequence;"
      fi
    done | LC_ALL=C sort -u
  )
  if [ -n "$autoinc_tables" ]; then
    printf '%s\n' "$autoinc_tables" | while IFS= read -r tbl; do
      [ -n "$tbl" ] || continue
      printf "needy-merge-sqlite: %s: table '%s' uses AUTOINCREMENT primary key and cannot be row-merged\n" "$rel" "$tbl" >&2
    done
    return 1
  fi

  all_tables=$(
    for db in "$merged_tmp" "$run_db"; do
      sqlite3 "$db" "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND sql IS NOT NULL;"
    done | LC_ALL=C sort -u
  )

  sql_file="$TMP_DIR/merge.sql"
  qrun=$(qlit "$run_db")
  {
    printf "PRAGMA foreign_keys = OFF;\n"
    printf "ATTACH DATABASE '%s' AS run_db;\n" "$qrun"
    if [ -n "$seed_db" ]; then
      qseed=$(qlit "$seed_db")
      printf "ATTACH DATABASE '%s' AS seed_db;\n" "$qseed"
    fi
    printf "BEGIN IMMEDIATE;\n"
  } >"$sql_file"

  had_error=0
  # Avoid subshell so `had_error` propagates cleanly in POSIX sh.
  tables_file="$TMP_DIR/tables.txt"
  printf '%s\n' "$all_tables" >"$tables_file"
  while IFS= read -r tbl; do
    [ -n "$tbl" ] || continue
    if ! merge_one_table "$rel" "$merged_tmp" "$run_db" "$seed_db" "$tbl" "$sql_file"; then
      had_error=1
    fi
  done <"$tables_file"

  if [ "$had_error" -ne 0 ]; then
    return 1
  fi

  printf "COMMIT;\n" >>"$sql_file"
  sqlite3 -bail "$merged_tmp" <"$sql_file"

  check=$(sqlite3 "$merged_tmp" "PRAGMA integrity_check;")
  if [ "$check" != "ok" ]; then
    printf 'needy-merge-sqlite: %s: integrity_check failed after merge: %s\n' "$rel" "$check" >&2
    return 1
  fi

  sqlite3 "$merged_tmp" "PRAGMA journal_mode=DELETE;" >/dev/null
  rm -f "${merged_tmp}-wal" "${merged_tmp}-shm" "${merged_tmp}-journal"
  cp -p "$merged_tmp" "$out_path"
}

dbs_file="$TMP_DIR/dbs.txt"
collect_db_paths >"$dbs_file"

status=0
while IFS= read -r rel; do
  [ -n "$rel" ] || continue
  if ! merge_one_db "$rel"; then
    status=1
  fi
done <"$dbs_file"

exit "$status"
