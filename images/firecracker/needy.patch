+/// Parses "vendor:device[:revision]" in hex.
+pub fn parse_pci_id(text: &str) -> Option<(u16, u16, u8)> {
+    let mut parts = text.split(':');
+    let vendor = u16::from_str_radix(parts.next()?, 16).ok()?;
+    let device = u16::from_str_radix(parts.next()?, 16).ok()?;
+    let revision = parts
+        .next()
+        .map_or(Some(0), |r| u8::from_str_radix(r, 16).ok())?;
+    Some((vendor, device, revision))
+}
